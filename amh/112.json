      "ar": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
      "tr": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡",
      "la": "be’alahi simi ijigi bet’ami ruhiruhi bet’ami azanyi behonewi፡፡"
    },
    {
      "verse": 1,
      "ar": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
      "tr": "በል «እርሱ አላህ አንድ ነው፡፡",
      "la": "beli «irisu alahi anidi newi፡፡"
    },
    {
      "verse": 2,
      "ar": "ٱللَّهُ ٱلصَّمَدُ",
      "tr": "«አላህ (የሁሉ) መጠጊያ ነው፡፡",
      "la": "«alahi (yehulu) met’egiya newi፡፡"
    },
    {
      "verse": 3,
      "ar": "لَمۡ یَلِدۡ وَلَمۡ یُولَدۡ",
      "tr": "«አልወለደም፤ አልተወለደምም፡፡",
      "la": "«aliweledemi፤ aliteweledemimi፡፡"
    },
    {
      "verse": 4,
      "ar": "وَلَمۡ یَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
      "tr": "«ለእርሱም አንድም ብጤ የለውም፡፡»",
      "la": "«le’irisumi anidimi bit’e yelewimi፡፡»"
    }
