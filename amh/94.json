{
  "chapter": 94,
  "title_am": "አል-ኢንሺራሕ",
  "title_ar": "الشرح",
  "title_la": "Ash-Sharh",
  "count": "8",
  "quran": [
    {
      "verse": 0,
      "ar": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
      "tr": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡",
      "la": "be’alahi simi ijigi bet’ami ruhiruhi bet’ami azanyi behonewi፡፡"
    },
    {
      "verse": 1,
      "ar": "۞ أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
      "tr": "ልብህን ለአንተ አላሰፋንልህምን? (አስፍተንልሃል)፡፡",
      "la": "libihini le’anite alasefanilihimini? (asifitenilihali)፡፡"
    },
    {
      "verse": 2,
      "ar": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
      "tr": "ሸክምህንም ካንተ አውርደንልሃል፡፡",
      "la": "shekimihinimi kanite awiridenilihali፡፡"
    },
    {
      "verse": 3,
      "ar": "ٱلَّذِیۤ أَنقَضَ ظَهۡرَكَ",
      "tr": "ያንን ጀርባህን ያከበደውን (ሸክም)፡፡",
      "la": "yanini jeribahini yakebedewini (shekimi)፡፡"
    },
    {
      "verse": 4,
      "ar": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
      "tr": "መወሳትህንም ላንተ ከፍ አድርገንልሃል፡፡",
      "la": "mewesatihinimi lanite kefi adirigenilihali፡፡"
    },
    {
      "verse": 5,
      "ar": "فَإِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرًا",
      "tr": "ከችግርም ጋር ምቾት አልለ፡፡",
      "la": "kechigirimi gari michoti alile፡፡"
    },
    {
      "verse": 6,
      "ar": "إِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرࣰا",
      "tr": "ከችግር ጋር በእርግጥ ምቾት አልለ፡፡",
      "la": "kechigiri gari be’irigit’i michoti alile፡፡"
    },
    {
      "verse": 7,
      "ar": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
      "tr": "በጨረስክም ጊዜ ልፋ፡፡ (ቀጥል)፡፡",
      "la": "bech’eresikimi gize lifa፡፡ (k’et’ili)፡፡"
    },
    {
      "verse": 8,
      "ar": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب",
      "tr": "ወደ ጌታህም ብቻ ከጅል፡፡",
      "la": "wede getahimi bicha kejili፡፡"
    }
  ]
}