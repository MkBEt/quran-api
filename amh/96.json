{
  "chapter": 96,
  "title_am": "አል-ዐለቅ",
  "title_ar": "العلق",
  "title_la": "Al-'Alaq",
  "count": "19",
  "quran": [
    {
      "verse": 0,
      "ar": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
      "tr": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡",
      "la": "be’alahi simi ijigi bet’ami ruhiruhi bet’ami azanyi behonewi፡፡"
    },
    {
      "verse": 1,
      "ar": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِی خَلَقَ",
      "tr": "አንብብ በዚያ (ሁሉን) በፈጠረው ጌታህ ስም፡፡",
      "la": "anibibi beziya (huluni) befet’erewi getahi simi፡፡"
    },
    {
      "verse": 2,
      "ar": "خَلَقَ ٱلۡإِنسَـٰنَ مِنۡ عَلَقٍ",
      "tr": "ሰውን ከረጋ ደም በፈጠረው (ጌታህ ስም)፡፡",
      "la": "sewini kerega demi befet’erewi (getahi simi)፡፡"
    },
    {
      "verse": 3,
      "ar": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
      "tr": "አንብብ፤ ጌታህ በጣም ቸር ሲኾን፤",
      "la": "anibibi፤ getahi bet’ami cheri sihoni፤"
    },
    {
      "verse": 4,
      "ar": "ٱلَّذِی عَلَّمَ بِٱلۡقَلَمِ",
      "tr": "ያ በብርዕ ያስተማረ፡፡",
      "la": "ya bebiri‘i yasitemare፡፡"
    },
    {
      "verse": 5,
      "ar": "عَلَّمَ ٱلۡإِنسَـٰنَ مَا لَمۡ یَعۡلَمۡ",
      "tr": "ሰውን ያላወቀውን ሁሉ ያሳወቀ ሲኾን፡፡",
      "la": "sewini yalawek’ewini hulu yasawek’e sihoni፡፡"
    },
    {
      "verse": 6,
      "ar": "كَلَّاۤ إِنَّ ٱلۡإِنسَـٰنَ لَیَطۡغَىٰۤ",
      "tr": "በእውነቱ ሰው ወሰንን ያልፋል፡፡",
      "la": "be’iwinetu sewi wesenini yalifali፡፡"
    },
    {
      "verse": 7,
      "ar": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰۤ",
      "tr": "ራሱን የተብቃቃ (ባለ ሀብት) ኾኖ ለማየቱ፡፡",
      "la": "rasuni yetebik’ak’a (bale habiti) hono lemayetu፡፡"
    },
    {
      "verse": 8,
      "ar": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰۤ",
      "tr": "መመለሻው ወደ ጌታህ ብቻ ነው፡፡",
      "la": "memeleshawi wede getahi bicha newi፡፡"
    },
    {
      "verse": 9,
      "ar": "أَرَءَیۡتَ ٱلَّذِی یَنۡهَىٰ",
      "tr": "አየህን? ያንን የሚከለክለውን፡፡",
      "la": "ayehini? yanini yemikelekilewini፡፡"
    },
    {
      "verse": 10,
      "ar": "عَبۡدًا إِذَا صَلَّىٰۤ",
      "tr": "ባሪያን በሰገደ ጊዜ፤",
      "la": "bariyani besegede gize፤"
    },
    {
      "verse": 11,
      "ar": "أَرَءَیۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰۤ",
      "tr": "አየህን? ንገረኝ (ተከልካዩ) በትክክለኛ መንገድ ላይ ቢኾን፤",
      "la": "ayehini? nigerenyi (tekelikayu) betikikilenya menigedi layi bihoni፤"
    },
    {
      "verse": 12,
      "ar": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰۤ",
      "tr": "ወይም (ፈጣሪውን) በመፍራት ቢያዝ፤",
      "la": "weyimi (fet’ariwini) bemefirati biyazi፤"
    },
    {
      "verse": 13,
      "ar": "أَرَءَیۡتَ إِن كَذَّبَ وَتَوَلَّىٰۤ",
      "tr": "አየህን? ንገረኝ (ከልካዩ) ቢያስተባብልና (ከእምነት) ቢሸሽ፤",
      "la": "ayehini? nigerenyi (kelikayu) biyasitebabilina (ke’imineti) bisheshi፤"
    },
    {
      "verse": 14,
      "ar": "أَلَمۡ یَعۡلَم بِأَنَّ ٱللَّهَ یَرَىٰ",
      "tr": "አላህ የሚያይ መኾኑን አያውቅምን",
      "la": "alahi yemiyayi mehonuni ayawik’imini"
    },
    {
      "verse": 15,
      "ar": "كَلَّا لَئِن لَّمۡ یَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِیَةِ",
      "tr": "ይተው ባይከለከል አናቱን ይዘን እንጎትተዋለን፡፡",
      "la": "yitewi bayikelekeli anatuni yizeni inigotitewaleni፡፡"
    },
    {
      "verse": 16,
      "ar": "نَاصِیَةࣲ كَـٰذِبَةٍ خَاطِئَةࣲ",
      "tr": "ውሸታም ስሕተተኛ የኾነችውን አናቱን፡፡",
      "la": "wishetami sihitetenya yehonechiwini anatuni፡፡"
    },
    {
      "verse": 17,
      "ar": "فَلۡیَدۡعُ نَادِیَهُۥ",
      "tr": "ሸንጎውንም ይጥራ፡፡",
      "la": "shenigowinimi yit’ira፡፡"
    },
    {
      "verse": 18,
      "ar": "سَنَدۡعُ ٱلزَّبَانِیَةَ",
      "tr": "(እኛም) ዘበኞቻችንን እንጠራለን፡፡",
      "la": "(inyami) zebenyochachinini init’eraleni፡፡"
    },
    {
      "verse": 19,
      "ar": "كَلَّا لَا تُطِعۡهُ وَ̅ٱ̅سۡ̅جُ̅دۡ̅ وَٱقۡتَرِب ۩",
      "tr": "ይከልከል አትታዘዘው፡፡ ስገድም፤ (ወደ አላህ) ተቃረብም፡፡",
      "la": "yikelikeli atitazezewi፡፡ sigedimi፤ (wede alahi) tek’arebimi፡፡"
    }
  ]
