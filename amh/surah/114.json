    {
      "verse": 6,
      "ar": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "tr": "«ከጋኔኖችም ከሰዎችም (ሰይጣናት እጠበቃለሁ በል)፡፡»",
      "la": "«keganenochimi kesewochimi (seyit’anati it’ebek’alehu beli)፡፡»"
    }
