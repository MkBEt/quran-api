    {
      "verse": 2,
      "ar": "مَلِكِ ٱلنَّاسِ",
      "tr": "«የሰዎች ሁሉ ንጉሥ በኾነው፡፡",
      "la": "«yesewochi hulu nigusi behonewi፡፡"
    },
    {
      "verse": 3,
      "ar": "إِلَـٰهِ ٱلنَّاسِ",
      "tr": "«የሰዎች አምላክ በኾነው፡፡",
      "la": "«yesewochi amilaki behonewi፡፡"
    },
    {
      "verse": 4,
      "ar": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "tr": "«ብቅ እልም ባይ ከኾነው ጎትጓች (ሰይጣን) ክፋት፡፡",
      "la": "«bik’i ilimi bayi kehonewi gotigwachi (seyit’ani) kifati፡፡"
