    {
      "verse": 21,
      "ar": "فَذَكِّرۡ إِنَّمَاۤ أَنتَ مُذَكِّرࣱ",
      "tr": "አስታውስም፤ አንተ አስታዋሽ ብቻ ነህና፡፡",
      "la": "asitawisimi፤ anite asitawashi bicha nehina፡፡"
    },
    {
      "verse": 22,
      "ar": "لَّسۡتَ عَلَیۡهِم بِمُصَۣیۡطِرٍ",
      "tr": "በእነርሱ ላይ ተሿሚ (አስገዳጅ) አይደለህም፡፡",
      "la": "be’inerisu layi teshwami (asigedaji) ayidelehimi፡፡"
    },
    {
      "verse": 23,
      "ar": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "tr": "ግን (ከእውነት) የዞረና የካደ ሰው፤",
      "la": "gini (ke’iwineti) yezorena yekade sewi፤"
    },
    {
      "verse": 24,
      "ar": "فَیُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
      "tr": "አላህ ታላቁን ቅጣት ይቀጣዋል፡፡",
      "la": "alahi talak’uni k’it’ati yik’et’awali፡፡"
    },
    {
      "verse": 25,
      "ar": "إِنَّ إِلَیۡنَاۤ إِیَابَهُمۡ",
      "tr": "መመለሻቸው ወደእኛ ብቻ ነው፡፡",
      "la": "memeleshachewi wede’inya bicha newi፡፡"
    },
    {
      "verse": 26,
      "ar": "ثُمَّ إِنَّ عَلَیۡنَا حِسَابَهُم",
      "tr": "ከዚያም ምርመራቸው በእኛ ላይ ብቻ ነው፡፡",
      "la": "keziyami mirimerachewi be’inya layi bicha newi፡፡"
    }
