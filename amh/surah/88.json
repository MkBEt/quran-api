{
  "chapter": 88,
  "title_am": "አል-ጋሺያህ",
  "title_ar": "الغاشية",
  "title_la": "Al-Ghashiyah",
  "count": "26",
  "quran": [
    {
      "verse": 0,
      "ar": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
      "tr": "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በኾነው፡፡",
      "la": "be’alahi simi ijigi bet’ami ruhiruhi bet’ami azanyi behonewi፡፡"
    },
    {
      "verse": 1,
      "ar": "هَلۡ أَتَىٰكَ حَدِیثُ ٱلۡغَـٰشِیَةِ",
      "tr": "የሸፋኝቱ (ትንሣኤ) ወሬ መጣህን",
      "la": "yeshefanyitu (tinisa’e) were met’ahini"
    },
    {
      "verse": 2,
      "ar": "وُجُوهࣱ یَوۡمَئِذٍ خَـٰشِعَةٌ",
      "tr": "ፊቶች በዚያ ቀን ተዋራጆች ናቸው፡፡",
      "la": "fitochi beziya k’eni tewarajochi nachewi፡፡"
    },
    {
      "verse": 3,
      "ar": "عَامِلَةࣱ نَّاصِبَةࣱ",
      "tr": "ሠሪዎች ለፊዎች ናቸው፡፡",
      "la": "seriwochi lefiwochi nachewi፡፡"
    },
    {
      "verse": 4,
      "ar": "تَصۡلَىٰ نَارًا حَامِیَةࣰ",
      "tr": "ተኳሳን እሳት ይገባሉ፡፡",
      "la": "tekwasani isati yigebalu፡፡"
    },
    {
      "verse": 5,
      "ar": "تُسۡقَىٰ مِنۡ عَیۡنٍ ءَانِیَةࣲ",
      "tr": "በጣም ከፈላች ምንጭ ይጋታሉ፡፡",
      "la": "bet’ami kefelachi minich’i yigatalu፡፡"
    },
    {
      "verse": 6,
      "ar": "لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِیعࣲ",
      "tr": "ለእነርሱ ዶሪዕ ከሚባል (እሾሃም) ዛፍ እንጅ ሌላ ምግብ የላቸውም፡፡",
      "la": "le’inerisu dori‘i kemibali (ishohami) zafi iniji lela migibi yelachewimi፡፡"
    },
    {
      "verse": 7,
      "ar": "لَّا یُسۡمِنُ وَلَا یُغۡنِی مِن جُوعࣲ",
      "tr": "የማያሰባ ከረኃብም የማያብቃቃ ከኾነው፡፡",
      "la": "yemayaseba kerehabimi yemayabik’ak’a kehonewi፡፡"
    },
    {
      "verse": 8,
      "ar": "وُجُوهࣱ یَوۡمَئِذࣲ نَّاعِمَةࣱ",
