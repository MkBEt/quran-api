    },
    {
      "verse": 11,
      "ar": "لَّا تَسۡمَعُ فِیهَا لَـٰغِیَةࣰ",
      "tr": "በውስጧ ውድቅን ነገር አይሰሙም፡፡",
      "la": "bewisit’wa widik’ini negeri ayisemumi፡፡"
    },
    {
      "verse": 12,
      "ar": "فِیهَا عَیۡنࣱ جَارِیَةࣱ",
      "tr": "በውስጧ ፈሳሾች ምንጮች አልሉ፡፡",
      "la": "bewisit’wa fesashochi minich’ochi alilu፡፡"
    },
    {
      "verse": 13,
      "ar": "فِیهَا سُرُرࣱ مَّرۡفُوعَةࣱ",
      "tr": "በውስጧ ከፍ የተደረጉ አልጋዎች አልሉ፡፡",
      "la": "bewisit’wa kefi yetederegu aligawochi alilu፡፡"
    },
    {
      "verse": 14,
      "ar": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ",
