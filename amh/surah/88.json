      "la": "beterita yetenoru birich’ik’owochimi፡፡"
    },
    {
      "verse": 15,
      "ar": "وَنَمَارِقُ مَصۡفُوفَةࣱ",
      "tr": "የተደረደሩ መከዳዎችም፡፡",
      "la": "yetederederu mekedawochimi፡፡"
    },
    {
      "verse": 16,
      "ar": "وَزَرَابِیُّ مَبۡثُوثَةٌ",
      "tr": "የተነጠፉ ስጋጃዎችም (አልሉ)፡፡",
      "la": "yetenet’efu sigajawochimi (alilu)፡፡"
    },
    {
      "verse": 17,
      "ar": "أَفَلَا یَنظُرُونَ إِلَى ٱلۡإِبِلِ كَیۡفَ خُلِقَتۡ",
      "tr": "(ከሓዲዎች) አይመለከቱምን? ወደ ግመል እንዴት እነደተፈጠረች",
      "la": "(kehadiwochi) ayimeleketumini? wede gimeli inideti inedetefet’erechi"
    },
    {
      "verse": 18,
      "ar": "وَإِلَى ٱلسَّمَاۤءِ كَیۡفَ رُفِعَتۡ",
      "tr": "ወደ ሰማይም እንዴት ከፍ እንደ ተደረገች",
      "la": "wede semayimi inideti kefi inide tederegechi"
    },
    {
      "verse": 19,
      "ar": "وَإِلَى ٱلۡجِبَالِ كَیۡفَ نُصِبَتۡ",
      "tr": "ወደ ተራራዎችም እንዴት እንደ ተቸከሉ",
      "la": "wede terarawochimi inideti inide techekelu"
    },
    {
      "verse": 20,
      "ar": "وَإِلَى ٱلۡأَرۡضِ كَیۡفَ سُطِحَتۡ",
      "tr": "ወደ ምድርም እንዴ እንደተዘረጋች (አይመለከቱምን)",
      "la": "wede midirimi inide inidetezeregachi (ayimeleketumini)"
